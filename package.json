{
  "name": "kwedo",
  "private": true,
  "version": "0.1.0",
  "description": "Kwedo : prototype de plateforme de crédit pour petits commerçants (données 100 % synthétiques)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "test:engine": ".venv/bin/python -m unittest discover -s packages/engine/tests -t packages/engine",
    "test:api": ".venv/bin/python -m unittest discover -s services/api/tests -t services/api",
    "test:gen": ".venv/bin/python -m unittest discover -s packages/generator/tests -t packages/generator",
    "api": ".venv/bin/python services/api/serveur.py",
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1"
  }
}
